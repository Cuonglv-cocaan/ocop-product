DUCKDB_PATH=data/ocop.duckdb
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

SQLITE_LEADS_PATH=data/leads.sqlite3
# Internal login and owned requests require PostgreSQL (local or Supabase).
# SQLite is retained for legacy import tools, not authenticated form writes.
LEADS_BACKEND=postgres
# PostgreSQL/Supabase connection string; never commit the actual value.
DATABASE_URL=
DUCKDB_READ_ONLY=false
